# Copy to ~/.config/apple-music-discord/env and chmod 600.
APPLE_MUSIC_DISCORD_CLIENT_ID=YOUR-DISCORD-APPLICATION-ID
# Optional: an uploaded Rich Presence asset key.
#APPLE_MUSIC_DISCORD_LARGE_IMAGE=apple_music
# Optional: two-letter Apple storefront; defaults to the Mac region.
#APPLE_MUSIC_DISCORD_STOREFRONT=us
#APPLE_MUSIC_DISCORD_LINKS=off
